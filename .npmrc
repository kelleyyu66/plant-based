# main pins vite@8 while @vitejs/plugin-react@4 only declares peer support up to
# vite@7, so a plain `npm install` dies on ERESOLVE. The combination works fine
# in practice (dev + `npm run build` both pass), so we opt out of the strict
# peer check to keep setup a one-liner for everyone.
# Proper fix: move plugin-react to a vite@8-compatible release, then delete this.
legacy-peer-deps=true
